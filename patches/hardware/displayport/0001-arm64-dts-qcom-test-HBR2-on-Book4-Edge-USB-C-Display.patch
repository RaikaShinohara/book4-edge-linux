From ccd43ae6e1e8331fd6c34cef2faf4b418d66d3ff Mon Sep 17 00:00:00 2001
From: RaikaShinohara <321751277+RaikaShinohara@users.noreply.github.com>
Date: Sun, 22 Nov 2026 16:59:24 +0000
Subject: [PATCH] arm64: dts: qcom: test HBR2 on Book4 Edge USB-C DisplayPort

Cap the two USB-C DisplayPort links at HBR2 when investigating
link-training failures with a USB-C video adapter. Preserve the
two-lane setup and the native HDMI link.
---
 .../dts/qcom/x1p42100-samsung-galaxy-book4-edge-np750xqa.dts  | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/x1p42100-samsung-galaxy-book4-edge-np750xqa.dts b/arch/arm64/boot/dts/qcom/x1p42100-samsung-galaxy-book4-edge-np750xqa.dts
index 62c04e614..080f8a026 100644
--- a/arch/arm64/boot/dts/qcom/x1p42100-samsung-galaxy-book4-edge-np750xqa.dts
+++ b/arch/arm64/boot/dts/qcom/x1p42100-samsung-galaxy-book4-edge-np750xqa.dts
@@ -1104,7 +1104,7 @@ &mdss_dp0 {
 
 &mdss_dp0_out {
 	data-lanes = <0 1>;
-	link-frequencies = /bits/ 64 <1620000000 2700000000 5400000000 8100000000>;
+	link-frequencies = /bits/ 64 <1620000000 2700000000 5400000000>;
 };
 
 &mdss_dp1 {
@@ -1113,7 +1113,7 @@ &mdss_dp1 {
 
 &mdss_dp1_out {
 	data-lanes = <0 1>;
-	link-frequencies = /bits/ 64 <1620000000 2700000000 5400000000 8100000000>;
+	link-frequencies = /bits/ 64 <1620000000 2700000000 5400000000>;
 };
 
 &mdss_dp2 {
