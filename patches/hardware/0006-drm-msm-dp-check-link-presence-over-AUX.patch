From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RaikaShinohara <321751277+RaikaShinohara@users.noreply.github.com>
Date: Sun, 22 Nov 2026 21:07:40 +0000
Subject: [PATCH] drm/msm/dp: check USB-C link presence over AUX before
 retrying

A Type-C bridge can deliver HPD out of band. Check link status over AUX before falling back to a different rate or lane count, and retain the last training error after the final attempt.
---
 drivers/gpu/drm/msm/dp/dp_ctrl.c | 23 ++++++++++++-----------
 1 file changed, 12 insertions(+), 11 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 86df6d9..659e1f6 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -2327,15 +2327,18 @@ int msm_dp_ctrl_on_link(struct msm_dp_ctrl *msm_dp_ctrl)
 	while (--link_train_max_retries) {
 		training_step = DP_TRAINING_NONE;
 		rc = msm_dp_ctrl_setup_main_link(ctrl, &training_step);
-		if (rc == 0) {
-			/* training completed successfully */
+		/* Preserve the training result when there is no retry left. */
+		if (!rc || link_train_max_retries == 1)
 			break;
-		} else if (training_step == DP_TRAINING_1) {
-			/* link train_1 failed */
-			if (!msm_dp_aux_is_link_connected(ctrl->aux))
-				break;
 
-			drm_dp_dpcd_read_link_status(ctrl->aux, link_status);
+		if (training_step == DP_TRAINING_1) {
+			/*
+			 * Read DPCD to check whether the sink is still present.
+			 * USB-C reports HPD out of band, so the native HPD
+			 * register may read disconnected while AUX works.
+			 */
+			if (drm_dp_dpcd_read_link_status(ctrl->aux, link_status) < 0)
+				break;
 
 			rc = msm_dp_ctrl_link_rate_down_shift(ctrl);
 			if (rc < 0) { /* already in RBR = 1.6G */
@@ -2356,12 +2359,10 @@ int msm_dp_ctrl_on_link(struct msm_dp_ctrl *msm_dp_ctrl)
 				}
 			}
 		} else if (training_step == DP_TRAINING_2) {
-			/* link train_2 failed */
-			if (!msm_dp_aux_is_link_connected(ctrl->aux))
+			/* Use AUX to check for disconnect, as in phase 1. */
+			if (drm_dp_dpcd_read_link_status(ctrl->aux, link_status) < 0)
 				break;
 
-			drm_dp_dpcd_read_link_status(ctrl->aux, link_status);
-
 			if (!drm_dp_clock_recovery_ok(link_status,
 					ctrl->link->link_params.num_lanes))
 				rc = msm_dp_ctrl_link_rate_down_shift(ctrl);
-- 
2.56.1

