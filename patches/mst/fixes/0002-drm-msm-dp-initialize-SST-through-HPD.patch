Subject: drm/msm/dp: keep plug state and persistent PM refs in HPD handling

The IRQ HPD series added an early return for an already initialized link.
Connector detection can run first and set plugged without reading EDID
or setting sink_count. On the Book4 Edge, the RTD2171 then enumerates as
connected, but the HDMI connector has neither EDID nor usable modes.

Leave connection state with the HPD handlers, balance detect's temporary
PM reference and retry when an attached SST branch gains a sink. Read
EDID on demand if an initialized SST link still lacks it.

Link: https://lists.openwall.net/linux-kernel/2026/11/12/428
Link: https://lore.kernel.org/r/20261127101417.24303-10-gianfranco.mariotti94@gmail.com
---
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -443,6 +443,7 @@
 
 static int msm_dp_hpd_plug_handle(struct msm_dp_display_private *dp)
 {
+	bool phy_deinit;
 	int ret;
 	struct platform_device *pdev = dp->msm_dp_display.pdev;
 
@@ -452,8 +453,12 @@
 
 	guard(mutex)(&dp->plugged_lock);
 
-	if (dp->plugged)
+	if (dp->plugged) {
+		/* A monitor can arrive downstream of an already powered branch. */
+		if (!dp->link->sink_count && !dp->msm_dp_display.mst_active)
+			return msm_dp_display_process_hpd_high(dp);
 		return 0;
+	}
 
 	ret = pm_runtime_resume_and_get(&pdev->dev);
 	if (ret) {
@@ -463,9 +468,16 @@
 
 	msm_dp_aux_enable_xfers(dp->aux, true);
 
-	msm_dp_display_host_phy_init(dp);
+	phy_deinit = msm_dp_display_host_phy_init(dp);
 
 	ret = msm_dp_display_process_hpd_high(dp);
+	if (ret && ret != -ENOTCONN) {
+		msm_dp_aux_enable_xfers(dp->aux, false);
+		if (phy_deinit)
+			msm_dp_display_host_phy_exit(dp);
+		pm_runtime_put(&pdev->dev);
+		return ret;
+	}
 
 	drm_dbg_dp(dp->drm_dev, "After, type=%d sink_count=%d\n",
 			dp->msm_dp_display.connector_type,
@@ -906,6 +918,7 @@
 int msm_dp_display_get_modes(struct msm_dp *dp)
 {
 	struct msm_dp_display_private *msm_dp_display;
+	struct drm_connector *connector;
 
 	if (!dp) {
 		DRM_ERROR("invalid params\n");
@@ -914,7 +927,25 @@
 
 	msm_dp_display = container_of(dp, struct msm_dp_display_private, msm_dp_display);
 
-	return drm_edid_connector_add_modes(msm_dp_display->panel->connector);
+	connector = msm_dp_display->panel->connector;
+
+	guard(mutex)(&msm_dp_display->plugged_lock);
+
+	/* The adapter may not have supplied an EDID during the first HPD. */
+	if (!dp->is_edp && !dp->mst_active && msm_dp_display->plugged &&
+	    msm_dp_display->link->sink_count && !connector->edid_blob_ptr &&
+	    connector->force != DRM_FORCE_OFF) {
+		const struct drm_edid *edid;
+
+		edid = drm_edid_read_ddc(connector, &msm_dp_display->aux->ddc);
+		if (edid) {
+			drm_edid_connector_update(connector, edid);
+			msm_dp_display->audio_supported = connector->display_info.has_audio;
+			drm_edid_free(edid);
+		}
+	}
+
+	return drm_edid_connector_add_modes(connector);
 }
 
 bool msm_dp_display_check_video_test(struct msm_dp *dp)
@@ -1035,26 +1066,22 @@
 	DRM_DEBUG_DP("aux link status: %x\n", ret);
 	if (!priv->plugged && !ret) {
 		DRM_DEBUG_DP("aux not connected\n");
-		priv->plugged = false;
 		goto end;
 	}
 
 	ret = drm_dp_read_dpcd_caps(priv->aux, dpcd);
 	if (ret) {
 		DRM_DEBUG_DP("failed to read caps\n");
-		priv->plugged = false;
 		goto end;
 	}
 
 	ret = drm_dp_read_desc(priv->aux, &desc, drm_dp_is_branch(dpcd));
 	if (ret) {
 		DRM_DEBUG_DP("failed to read desc\n");
-		priv->plugged = false;
 		goto end;
 	}
 
 	status = connector_status_connected;
-	priv->plugged = true;
 
 	if (drm_dp_read_sink_count_cap(connector, dpcd, &desc)) {
 		int sink_count = drm_dp_read_sink_count(priv->aux);
@@ -1071,18 +1098,13 @@
 		status = connector_status_disconnected;
 
 end:
-	/*
-	 * If we detected the DPRX, leave the controller on so that it doesn't
-	 * lose the state.
-	 */
+	/* Only the HPD handlers own the persistent reference and plug state. */
 	if (!priv->plugged) {
-		if (phy_deinit) {
-			msm_dp_aux_enable_xfers(priv->aux, false);
+		msm_dp_aux_enable_xfers(priv->aux, false);
+		if (phy_deinit)
 			msm_dp_display_host_phy_exit(priv);
-		}
-
-		pm_runtime_put_sync(&dp->pdev->dev);
-	}
+	}
+	pm_runtime_put(&dp->pdev->dev);
 
 	return status;
 }
