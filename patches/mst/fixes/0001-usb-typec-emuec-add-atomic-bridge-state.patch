Subject: usb: typec: samsung-emuec: provide atomic DRM bridge state helpers

DRM creates a private atomic state for this bridge during attach. The
Samsung EmuEC bridge needs callbacks to create, duplicate and destroy that
state on linux-next. Use the standard helpers for the stateless bridge.

---
--- a/drivers/usb/typec/samsung-emuec.c
+++ b/drivers/usb/typec/samsung-emuec.c
@@ -29,6 +29,7 @@
 #include <linux/usb/typec_retimer.h>
 #include <linux/workqueue.h>
 
+#include <drm/drm_atomic_helper.h>
 #include <drm/drm_bridge.h>
 
 #define S2MM006_IRQ_FIRST		0x02
@@ -730,6 +731,9 @@
 }
 
 static const struct drm_bridge_funcs samsung_emuec_bridge_funcs = {
+	.atomic_create_state = drm_atomic_helper_bridge_create_state,
+	.atomic_duplicate_state = drm_atomic_helper_bridge_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_bridge_destroy_state,
 	.attach = samsung_emuec_bridge_attach,
 	.hpd_enable = samsung_emuec_bridge_hpd_enable,
 };
