+		pinctrl-0 = <&tpad_default>;
+		pinctrl-names = "default";
+
+		status = "fail-needs-probe";
+	};
+
+	/* SYN2602 */
+	touchpad@20 {
+		compatible = "hid-over-i2c";
+		reg = <0x20>;
+
+		hid-descr-addr = <0x20>;
+		interrupts-extended = <&tlmm 3 IRQ_TYPE_LEVEL_LOW>;
+
+		pinctrl-0 = <&tpad_default>;
+		pinctrl-names = "default";
+
+		status = "fail-needs-probe";
+	};
+
+	/* ZNT0001 (Zinitix) */
+	touchpad@40 {
+		compatible = "hid-over-i2c";
+		reg = <0x40>;
+
+		hid-descr-addr = <0xe>;
+		interrupts-extended = <&tlmm 3 IRQ_TYPE_LEVEL_LOW>;
+
+		pinctrl-0 = <&tpad_default>;
+		pinctrl-names = "default";
+
+		status = "fail-needs-probe";
+	};
+
+	/* IMG4100 */
+	touchpad@50 {
+		compatible = "hid-over-i2c";
+		reg = <0x50>;
+
+		hid-descr-addr = <0x1>;
+		interrupts-extended = <&tlmm 3 IRQ_TYPE_LEVEL_LOW>;
